# Конфигурация сборки и запуска.
# Скопируйте в .env и настройте. Не добавляйте .env с секретами в Git.

# --- Android SDK ---
# Путь к Android SDK (обычно задаётся в android/local.properties)
ANDROID_SDK_PATH=/path/to/android-sdk

# --- Модели ---
# Путь к модели распознавания речи (ggml/gguf) внутри приложения
ASR_MODEL_PATH=models/whisper-small.bin
# Путь к модели диаризации
DIARIZATION_MODEL_PATH=models/diarization.onnx
# Путь к локальной языковой модели
LLM_MODEL_PATH=models/gemma-2-2b-q4.gguf

# --- Параметры обработки ---
# Ожидаемое число говорящих; пусто — определять автоматически
EXPECTED_SPEAKERS=
# Включить восстановление пунктуации языковой моделью
USE_LLM=true
# Размер фрагмента при обработке длинных записей, секунды
CHUNK_SECONDS=30

# --- Тестовые данные ---
# Каталог с контрольными записями
TEST_DATA_DIR=artifacts/test-results
