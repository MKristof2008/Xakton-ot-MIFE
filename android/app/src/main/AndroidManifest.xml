<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Разрешение на интернет намеренно НЕ запрашивается.
        По ТЗ приложение обязано работать офлайн, без облачных API.
        Отсутствие INTERNET в манифесте — техническая гарантия этого требования.
    -->

    <!-- Запись аудио с микрофона (экран импорта). Хранилище не запрашивается: SAF. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stenograph">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
