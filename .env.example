# AITunnel (OpenAI-совместимый API). Ключ: https://aitunnel.ru/panel/keys
# Нужен только для LLM-шагов: clean, minutes, ask, speakers, tasks.
# Локальные шаги (transcribe, diarize, run_local) работают без ключа.
AITUNNEL_API_KEY=sk-aitunnel-...
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
AITUNNEL_MODEL=gpt-4o-mini

# --- ASR ---
# Размер локальной модели whisper: tiny | base | small | medium | large-v3
ASR_LOCAL_MODEL=small
# Язык записи по умолчанию
ASR_LANGUAGE=ru

# --- Диаризация ---
# Бэкенд: pyannote | speechbrain | mfcc.
# Пусто = auto: первый доступный из этого списка.
DIARIZATION_BACKEND=
# Эмбеддинги говорящего для speechbrain/mfcc: auto | ecapa | mfcc
EMBEDDING_BACKEND=auto
# Куда складывать веса ECAPA
ECAPA_CACHE=.ecapa_cache

# --- pyannote (опционально) ---
# Gated-модель: примите условия на huggingface.co/pyannote/speaker-diarization-3.1
# и вставьте токен. Без него используется speechbrain.
# HF_TOKEN=hf_...

# --- Опционально ---
# Свой бинарник ffmpeg, если его нет в PATH
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe